{
  "name": "pinkas",
  "private": true,
  "version": "0.1.0",
  "description": "פנקס — personal cash-flow manager (self-hosted, single user)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run --project domain --project shared --project file-parsers --project fixtures --project web --project mcp-server",
    "test:integration": "vitest run --project db --project api --project sync-worker",
    "db:generate": "pnpm --filter @pinkas/db generate",
    "db:migrate": "pnpm --filter @pinkas/db migrate",
    "seed": "pnpm --filter @pinkas/db seed",
    "pinkas": "tsx scripts/cli.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "libsodium-wrappers": "0.8.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "overrides": {
      "puppeteer": "24.43.1"
    },
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "puppeteer"
    ]
  },
  "type": "module"
}
