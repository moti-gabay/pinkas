    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@pinkas/shared": "workspace:*",
    "@pinkas/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pinkas/config": "workspace:*",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "@testcontainers/postgresql": "^12.2.1",
    "tsx": "^4.23.15"
  }
}
