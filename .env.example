# Copy to .env. Never commit .env.
NODE_ENV=production
LOG_LEVEL=info
TZ=Asia/Jerusalem

# API session cookie signing secret (>= 32 chars): `openssl rand -hex 32`
SESSION_SECRET=

# Public half of the credentials keypair, printed by `pnpm pinkas keygen`.
# The private half lives in ~/.pinkas/worker.key and is mounted ONLY into sync-worker.
CREDENTIALS_PUBLIC_KEY=

# Claude API (optional until Phase 3). Categorization: Haiku; insights/PDF: Sonnet.
ANTHROPIC_API_KEY=
LLM_MODEL_CATEGORIZE=claude-haiku-5-5
LLM_MODEL_INSIGHTS=claude-sonnet-5-5

# MCP server bearer token: `openssl rand -hex 24`
MCP_TOKEN=

# Sync
HISTORY_MONTHS=12
SCRAPE_TIMEOUT_MS=120000
# Egress proxy (Phase 2, last step): off | log | enforce
EGRESS_MODE=off

# Backups (`pnpm pinkas backup`): optional folder that receives a copy of each ENCRYPTED backup, e.g. a synced
# cloud folder such as /mnt/c/Users/<you>/OneDrive/pinkas-backups. Never put backup.key there.
BACKUP_COPY_DIR=

# Host port for the api (bound to 127.0.0.1 only). Default 3010, away from the usual dev-server port 3000.
PINKAS_API_PORT=3010
