# Shared builder for api / mcp-server (worker has its own Dockerfile because of Chromium).
# Base images are pinned by digest; bump the tag and digest together.
FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS node

FROM node AS base
ENV CI=true PNPM_HOME=/pnpm PATH=/pnpm:$PATH PUPPETEER_SKIP_DOWNLOAD=1
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/mcp-server/package.json apps/mcp-server/
COPY apps/sync-worker/package.json apps/sync-worker/
COPY apps/web/package.json apps/web/
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY packages/domain/package.json packages/domain/
COPY packages/db/package.json packages/db/
COPY packages/file-parsers/package.json packages/file-parsers/
COPY packages/fixtures/package.json packages/fixtures/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
ARG APP
RUN pnpm turbo run build --filter=@pinkas/${APP}...
# A self-contained copy of the app: its dist, its production dependencies, workspace packages included.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm --filter=@pinkas/${APP} deploy --prod --legacy /out

# No pnpm, no dev dependencies, no workspace sources. Code is root-owned and read-only for the `node` user.
FROM node AS runtime
ARG APP
ENV NODE_ENV=production
COPY --from=build /out /app
# The api's only writable path besides /tmp. A new named volume mounted here inherits this ownership.
RUN if [ "$APP" = api ]; then mkdir -p /data/uploads && chown node:node /data/uploads; fi
USER node
WORKDIR /app
CMD ["node", "dist/server.js"]
